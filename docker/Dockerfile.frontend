# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app
COPY frontend/package*.json ./
RUN if [ -f package.json ]; then npm ci; else mkdir -p node_modules; fi

COPY frontend/ ./
RUN if [ -f vite.config.ts ] || [ -f vite.config.js ]; then npm run build; else mkdir -p dist && echo '<html><body>LoadForge Dashboard Mock</body></html>' > dist/index.html; fi

# Stage 2: Serve
FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
